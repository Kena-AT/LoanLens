# LoanLens Environment Configuration
# Copy this file to .env and customize for your environment

# Application Settings
APP_NAME=LoanLens
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Data Paths
DATA_RAW_PATH=data/credit_data.csv
DATA_CLEAN_PATH=data/clean_credit_data.csv

# Model Settings
MODEL_RANDOM_STATE=42
MODEL_TEST_SIZE=0.2
MODEL_DEFAULT_THRESHOLD=0.5

# Model Paths
MODELS_DIR=notebooks/models
DEFAULT_MODEL_PATH=notebooks/models/xgb_smote_model.pkl
SCALER_PATH=notebooks/models/scaler.joblib

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/loanlens.log

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Database (if needed in future)
# DATABASE_URL=sqlite:///data/loanlens.db
